---
import Base from '../layouts/Base.astro';
import { posts } from '../data/news';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const fmt = (d: string) => new Date(d + 'T00:00:00Z').toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---
<Base title="News & Articles | Wayae Studios" description="News, updates and articles from Wayae Studios.">
  <main class="page">
    <h1>News &amp; Articles</h1>
    <p class="meta">Updates from the studio</p>
    {posts.map((p) => (
      <article class="card c2 post" id={p.slug}>
        <time datetime={p.date}>{fmt(p.date)}</time>
        <h2>{p.title}</h2>
        {p.body.map((para) => <p>{para}</p>)}
      </article>
    ))}
    <p class="meta"><a href={base}>← Back home</a></p>
  </main>
</Base>
