---
const chapters = [
  ['africa', 'Africa', 'The Savanna'],
  ['asia', 'Asia', 'Mountains and Jungles'],
  ['europe', 'Europe', 'Forests and Meadows'],
  ['north_america', 'North America', 'Prairies and Woodlands'],
  ['south_america', 'South America', 'The Rainforest'],
  ['australia', 'Australia', 'The Outback'],
  ['polar', 'The Poles', 'Ice and Snow'],
  ['oceans', 'The Oceans', 'Under the Waves'],
  ['garden', 'The Garden', 'Tiny Neighbours'],
  ['world', 'Around the World', 'The Grand Finale'],
];
const cards = ['beaver', 'arctic_fox', 'axolotl', 'bald_eagle', 'bee', 'bison'];
const features = [
  ['Study, flip, match', 'Every page opens face up for a moment. Memorise it, then match every pair before the clock runs out.'],
  ['100 levels, 10 chapters', 'Travel from the savanna to the poles, with grids that grow from 2x2 up to 6x6.'],
  ['72 paper-cut animals', 'Every animal and habitat is handmade in a paper-cut collage style.'],
  ['Stars and streaks', 'Chain matches for bonus points and earn up to three stars on every page.'],
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/png" href="/app-icon.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <title>Wayae Studios</title>
  <meta name="description" content="Wayae Studios is an indie game studio. Our first game is Paper Zoo, a paper-cut animal memory match game for Android." />
  <meta property="og:title" content="Wayae Studios" />
  <meta property="og:description" content="Home of Paper Zoo, a paper-cut animal memory match game." />
  <meta property="og:image" content="/paper-zoo-logo.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&display=swap" rel="stylesheet" />
</head>
<body>
  <header class="nav">
    <a class="brand" href="#top"><img src="/wayae-logo.png" alt="Wayae Studios" /></a>
    <nav>
      <a href="#game">Paper Zoo</a>
      <a href="#chapters">Chapters</a>
      <a href="#studio">Studio</a>
    </nav>
  </header>

  <main id="top">
    <section class="hero">
      <img class="hero-logo" src="/paper-zoo-logo.png" alt="Paper Zoo: Animal Memory Match" />
      <p class="lead">A paper-cut storybook memory game. Study the page, flip the cards and match every animal before time runs out.</p>
      <div class="cta">
        <span class="btn primary">Coming soon to Android</span>
        <a class="btn" href="#game">See the game</a>
      </div>
    </section>

    <section id="game" class="block">
      <h2>About Paper Zoo</h2>
      <p class="intro">Paper Zoo is our first game: a cosy memory match for everyone, set in a storybook of animals and their habitats. Each page shows its cards for a few seconds, then flips them. Remember where everyone is hiding.</p>
      <div class="grid">
        {features.map(([t, p]) => (<article class="card"><h3>{t}</h3><p>{p}</p></article>))}
      </div>
      <div class="cards" aria-label="Some of the animals">
        {cards.map((c) => (<img src={`/cards/${c}.png`} alt={c.replace('_', ' ')} loading="lazy" />))}
      </div>
    </section>

    <section id="chapters" class="block wide">
      <h2>Ten chapters around the world</h2>
      <div class="chapters">
        {chapters.map(([id, t, s], i) => (
          <figure>
            <img src={`/scenes/${id}.jpg`} alt={t} loading="lazy" />
            <figcaption><b>{i + 1}. {t}</b><span>{s}</span></figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section id="studio" class="block center">
      <h2>About Wayae Studios</h2>
      <p class="intro">Wayae Studios is a small indie studio making handcrafted games. Paper Zoo is just the beginning.</p>
      <a class="btn primary" href="mailto:hello@example.com">Get in touch</a>
    </section>
  </main>

  <footer>© {new Date().getFullYear()} Wayae Studios</footer>
</body>
</html>

<style is:global>
  :root { --bg:#1d1410; --bg2:#2a1d16; --cream:#f6ead3; --orange:#f08a2c; --brown:#8b5a35; }
  * { box-sizing:border-box; }
  html { scroll-behavior:smooth; }
  body { margin:0; background:var(--bg); color:var(--cream); font-family:'Fredoka', system-ui, sans-serif; line-height:1.6; }
  a { color:inherit; }
  img { max-width:100%; }
  .nav { display:flex; justify-content:space-between; align-items:center; gap:1rem; flex-wrap:wrap; max-width:1100px; margin:0 auto; padding:.75rem 1.25rem; }
  .brand img { height:56px; display:block; }
  .nav nav { display:flex; gap:1.5rem; }
  .nav nav a { text-decoration:none; font-weight:500; opacity:.85; }
  .nav nav a:hover { opacity:1; color:var(--orange); }
  .hero { text-align:center; padding:2rem 1.25rem 4rem; max-width:760px; margin:0 auto; background:radial-gradient(ellipse at 50% 30%, #4a3022 0%, transparent 65%); }
  .hero-logo { width:min(440px,85%); filter:drop-shadow(0 12px 24px rgba(0,0,0,.5)); }
  .lead { font-size:1.3rem; max-width:560px; margin:1rem auto 1.75rem; }
  .cta { display:flex; gap:.75rem; justify-content:center; flex-wrap:wrap; }
  .btn { display:inline-block; padding:.7rem 1.5rem; border-radius:999px; border:2px solid var(--cream); text-decoration:none; font-weight:600; transition:transform .12s; }
  a.btn:hover { transform:translateY(-2px); }
  .btn.primary { background:var(--orange); border-color:var(--orange); color:#2a1405; }
  .block { max-width:1000px; margin:0 auto; padding:3.5rem 1.25rem; }
  .block.wide { max-width:1100px; }
  .block.center { text-align:center; }
  h2 { font-size:clamp(1.8rem,5vw,2.5rem); margin:0 0 1rem; text-align:center; }
  .intro { max-width:640px; margin:0 auto 2rem; text-align:center; font-size:1.1rem; opacity:.9; }
  .grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:1rem; }
  .card { background:var(--bg2); border:2px solid var(--brown); border-radius:18px; padding:1.25rem; }
  .card h3 { margin:0 0 .4rem; color:var(--orange); }
  .card p { margin:0; }
  .cards { display:flex; justify-content:center; flex-wrap:wrap; gap:1rem; margin-top:2.5rem; }
  .cards img { width:clamp(80px,14vw,120px); transition:transform .2s; }
  .cards img:nth-child(odd) { transform:rotate(-4deg); }
  .cards img:nth-child(even) { transform:rotate(4deg); }
  .cards img:hover { transform:rotate(0) scale(1.08); }
  .chapters { display:grid; grid-template-columns:repeat(auto-fill,minmax(200px,1fr)); gap:1rem; margin-top:2rem; }
  .chapters figure { margin:0; background:var(--bg2); border-radius:14px; overflow:hidden; border:2px solid var(--brown); }
  .chapters img { display:block; width:100%; aspect-ratio:1; object-fit:cover; }
  .chapters figcaption { padding:.6rem .8rem; display:flex; flex-direction:column; font-size:.9rem; }
  .chapters figcaption span { opacity:.7; }
  footer { text-align:center; padding:2.5rem 1rem; opacity:.6; font-size:.9rem; }
</style>
