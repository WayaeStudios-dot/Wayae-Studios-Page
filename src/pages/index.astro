---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const chapters = ['africa','asia','europe','north_america','south_america','australia','polar','oceans'];
const pillars = [
  ['controller.png', 'Games first', 'We design and build mobile and PC games that are genuinely fun to play.', 'c1'],
  ['brain.png', 'Learning built in', 'Memory, geography, nature and more, woven into the play instead of bolted on.', 'c2'],
  ['scissors.png', 'Handcrafted', 'Bright, tactile art and cosy sound, made with care by a small team.', 'c3'],
  ['devices.png', 'Mobile and PC', 'Android today, with PC and more platforms on the way.', 'c4'],
];
const soon = [
  ['Project 2', 'c2', 'placeholders/puzzle.svg'],
  ['Project 3', 'c3', 'placeholders/rocket.svg'],
  ['Project 4', 'c4', 'placeholders/brush.svg'],
];
---
<Base>
  <main id="top">
    <section class="hero">
      <span class="blob b1"></span><span class="blob b2"></span><span class="blob b3"></span>
      <p class="tag">Indie game studio</p>
      <h1>We make <span class="w1">playful</span> games that <span class="w2">teach</span> without trying.</h1>
      <p class="lead">Wayae Studios builds colourful mobile and PC games with learning tucked inside the fun.</p>
      <div class="cta">
        <a class="btn pink" href="#games">See our games</a>
        <a class="btn ghost" href="#contact">Say hello</a>
      </div>
    </section>

    <section id="about" class="block">
      <h2>What we are about</h2>
      <div class="grid">
        {pillars.map(([icon, t, p, c]) => (
          <article class={`card ${c}`}>{icon && <img class="icon-img" src={`${base}${icon}`} alt="" />}<h3>{t}</h3><p>{p}</p></article>
        ))}
      </div>
    </section>

    <section id="games" class="block">
      <h2>Our games</h2>

      <article class="featured">
        <div class="f-art">
          <img src={`${base}paper-zoo-logo.png`} alt="Paper Zoo: Animal Memory Match" />
        </div>
        <div class="f-body">
          <span class="pill green">Internal testing</span>
          <h3>Paper Zoo</h3>
          <p>A paper-cut storybook memory game for Android. Study the page, flip the cards and match every animal before time runs out. Travel through 10 chapters and 100 levels, meeting 72 animals along the way.</p>
          <ul>
            <li>Sharpens memory and focus</li>
            <li>Learn animals and where they live</li>
            <li>Stars, streaks and a cosy storybook feel</li>
          </ul>
          <span class="btn orange">In internal testing on Android</span>
        </div>
        <div class="strip">
          {chapters.map((c) => (<img src={`${base}scenes/${c}.jpg`} alt="" loading="lazy" />))}
        </div>
      </article>

      <div class="soon">
        {soon.map(([t, c, img]) => (
          <article class={`card soon-card ${c}`}>
            <img class="icon-img" src={`${base}${img}`} alt="" />
            <h3>{t}</h3>
            <span class="pill">Coming soon</span>
          </article>
        ))}
      </div>
    </section>

    <section id="contact" class="block center">
      <div class="contact">
        <h2>Let us play together</h2>
        <p>Questions, ideas or want to follow along? Drop us a line.</p>
        <a class="btn pink" href="mailto:trivutam@gmail.com">Get in touch</a>
      </div>
    </section>
  </main>

</Base>
