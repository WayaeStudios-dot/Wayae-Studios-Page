---
interface Props { title?: string; description?: string; }
const { title = 'Wayae Studios', description = 'Wayae Studios makes playful mobile and PC games with learning built in. Now in internal testing: Paper Zoo.' } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/png" href={`${base}favicon.png`} />
  <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={`${Astro.site ? Astro.site.origin : ''}${base}paper-zoo-logo.png`} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&display=swap" rel="stylesheet" />
</head>
<body>
  <header class="nav">
    <a class="brand" href={base}><img src={`${base}wayae-logo.png`} alt="Wayae Studios" /></a>
    <nav>
      <a href={`${base}#about`}>About</a>
      <a href={`${base}#games`}>Games</a>
      <a href={`${base}news/`}>News</a>
      <a href={`${base}#contact`}>Contact</a>
    </nav>
  </header>
  <slot />
  <footer>
    <a href={`${base}privacy/`}>Privacy Policy</a> · © {new Date().getFullYear()} Wayae Studios
  </footer>
</body>
</html>

<style is:global>
  :root {
    --ink:#2b2340; --pink:#ff5d8f; --orange:#ff9f1c; --yellow:#ffd23f; --green:#2ec4b6; --blue:#4d96ff; --purple:#9b5de5;
  }
  * { box-sizing:border-box; }
  html { scroll-behavior:smooth; }
  body { margin:0; background:#fff; color:var(--ink); font-family:'Fredoka', system-ui, sans-serif; line-height:1.6; overflow-x:hidden; }
  a { color:inherit; }
  img { max-width:100%; }
  .nav { display:flex; justify-content:space-between; align-items:center; gap:1rem; flex-wrap:wrap; max-width:1100px; margin:0 auto; padding:.75rem 1.25rem; position:relative; z-index:2; }
  .brand img { height:56px; display:block; }
  .nav nav { display:flex; gap:1.5rem; }
  .nav nav a { text-decoration:none; font-weight:600; }
  .nav nav a:hover { color:var(--pink); }

  .hero { position:relative; text-align:center; padding:3rem 1.25rem 5rem; max-width:820px; margin:0 auto; }
  .blob { position:absolute; border-radius:50%; z-index:0; opacity:.9; }
  .b1 { width:150px; height:150px; background:var(--yellow); top:0; left:-60px; }
  .b2 { width:100px; height:100px; background:var(--green); top:40%; right:-40px; }
  .b3 { width:70px; height:70px; background:var(--pink); bottom:10px; left:8%; }
  .hero > *:not(.blob) { position:relative; z-index:1; }
  .tag { display:inline-block; background:var(--purple); color:#fff; padding:.25rem 1rem; border-radius:999px; font-weight:600; margin:0 0 1rem; }
  h1 { font-size:clamp(2.2rem,7vw,4rem); line-height:1.1; margin:0 0 1rem; }
  .w1 { color:var(--pink); }
  .w2 { color:var(--blue); }
  .lead { font-size:1.25rem; max-width:520px; margin:0 auto 1.75rem; }
  .cta { display:flex; gap:.75rem; justify-content:center; flex-wrap:wrap; }
  .btn { display:inline-block; padding:.75rem 1.6rem; border-radius:999px; border:3px solid var(--ink); text-decoration:none; font-weight:700; box-shadow:0 4px 0 var(--ink); transition:transform .1s, box-shadow .1s; }
  a.btn:hover { transform:translateY(2px); box-shadow:0 2px 0 var(--ink); }
  .btn.pink { background:var(--pink); color:#fff; }
  .btn.orange { background:var(--orange); color:var(--ink); }
  .btn.ghost { background:#fff; }

  .block { max-width:1050px; margin:0 auto; padding:3.5rem 1.25rem; }
  .block.center { text-align:center; }
  h2 { font-size:clamp(1.8rem,5vw,2.6rem); margin:0 0 1.5rem; text-align:center; }
  .grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:1.25rem; }
  .card { border:3px solid var(--ink); border-radius:24px; padding:1.4rem; box-shadow:0 6px 0 var(--ink); }
  .card h3 { margin:.3rem 0; }
  .card p { margin:0; }
  .icon { font-size:2rem; display:block; }
  .c1 { background:#ffe3ec; } .c2 { background:#fff1cc; } .c3 { background:#d6f5f1; } .c4 { background:#dbe9ff; }
  .grid .card:nth-child(odd) { transform:rotate(-1deg); }
  .grid .card:nth-child(even) { transform:rotate(1deg); }

  .featured { border:3px solid var(--ink); border-radius:28px; box-shadow:0 8px 0 var(--ink); background:#fff7e6; overflow:hidden; display:grid; grid-template-columns:1fr 1.2fr; gap:1.5rem; padding:1.75rem; }
  .f-art { display:flex; align-items:center; justify-content:center; background:#ffd9a0; border-radius:20px; padding:1rem; }
  .f-art img { width:min(340px,100%); }
  .f-body h3 { font-size:2rem; margin:.5rem 0; }
  .f-body ul { padding-left:1.2rem; margin:0 0 1.25rem; }
  .pill { display:inline-block; padding:.15rem .8rem; border-radius:999px; background:var(--yellow); border:2px solid var(--ink); font-weight:600; font-size:.85rem; }
  .pill.green { background:var(--green); color:#fff; }
  .strip { grid-column:1 / -1; display:grid; grid-template-columns:repeat(auto-fit,minmax(90px,1fr)); gap:.6rem; }
  .strip img { width:100%; aspect-ratio:1; object-fit:cover; border-radius:14px; border:2px solid var(--ink); }

  .soon { display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:1.25rem; margin-top:2rem; }
  .soon-card { text-align:center; border-style:dashed; }
  .soon-card .icon { font-size:2.6rem; }

  .contact { background:var(--blue); color:#fff; border:3px solid var(--ink); border-radius:28px; box-shadow:0 8px 0 var(--ink); padding:2.5rem 1.25rem; }
  .contact h2 { margin-bottom:.5rem; }
  .contact .btn { margin-top:.5rem; }
  footer { text-align:center; padding:2.5rem 1rem; opacity:.7; font-size:.9rem; }

  @media (max-width:760px) { .featured { grid-template-columns:1fr; } .b1 { left:-90px; } .b2 { right:-60px; } }

  footer a { text-decoration:underline; }
  .page { max-width:760px; margin:0 auto; padding:2rem 1.25rem 3rem; }
  .page h1 { font-size:clamp(2rem,6vw,3rem); text-align:center; }
  .page h2 { text-align:left; font-size:1.5rem; margin:2rem 0 .5rem; }
  .page .meta { text-align:center; opacity:.7; margin-bottom:2rem; }
  .post { margin-bottom:1.5rem; }
  .post time { font-size:.9rem; opacity:.7; }
  .post h2 { margin:.4rem 0 .5rem; }
</style>
